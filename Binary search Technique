package q17128;
import java.io.*;
import java.util.Scanner;
class CTJ17128
	{
		public static void main(String args[])
		{
			int i,pos=0,mid,key,flag=0,l,h;
			int a[]=new int[30];
			Scanner obj=new Scanner(System.in);
			System.out.print("");
			int n=obj.nextInt();
			System.out.print("");
			for(i=0;i<n;i++)
				a[i]=obj.nextInt();
			System.out.print("");
			key=obj.nextInt();
			l=0;
			h=n-1;
			while(l<=h)
				{
					mid=(l+h)/2;
					if(key==a[mid])
					{
						flag=1;
						pos=mid;
						break;
					}
					else if(key>a[mid])
						l=mid+1;
					else
						h=mid-1;
				}
			if(flag==1)
				System.out.print(pos);
			else
				System.out.print("Not found");
		}
	}
